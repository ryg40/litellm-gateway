# Create .env with: python3 scripts/create-env.py
# It copies this file, gives each empty secret below a new random value,
# writes mode 0600 and refuses to replace a .env that exists.
# Never commit credentials.
# Secrets that the stack makes itself. Leave them empty here.
# Compose refuses to start while LITELLM_MASTER_KEY, LITELLM_SALT_KEY,
# POSTGRES_PASSWORD or UI_PASSWORD is empty.
LITELLM_MASTER_KEY=
CODEX_MASTER_KEY=
COPILOT_MASTER_KEY=
UI_PASSWORD=
POSTGRES_PASSWORD=
# Keep this stable after database initialization.
LITELLM_SALT_KEY=
UI_USERNAME=admin
# Provider credentials. Set the ones that you use.
OPENROUTER_API_KEY=
LOCAL_API_KEY=local-no-key
# Base URL of the example local route in config/gateway.example.yaml.
LOCAL_API_BASE=http://local-llm.example:8080/v1
# Add only after obtaining a separate supported credential:
# ANTHROPIC_API_KEY=REPLACE_WITH_SEPARATE_KEY_OR_TOKEN

# Host settings. See docs/host-configuration.md.
# Gateway configuration. Unset: config/gateway.example.yaml. The scripts write the host file.
# GATEWAY_CONFIG=./.local/config/gateway.yaml
# Configuration of the service copilot (compose.copilot.yaml). Unset: config/copilot.yaml.
# COPILOT_CONFIG=./.local/config/copilot.yaml
# Published address of the gateway. Unset: 127.0.0.1:4321.
# GATEWAY_PORT=127.0.0.1:4321
# Endpoints for scripts/sync-local-models.py, as name=url pairs separated by commas.
# LOCAL_ENDPOINTS=llamaswap=http://local-llm.example:9292/v1,vllm=http://local-llm.example:8001/v1
# LOCAL_EMBEDDING_MODEL=REPLACE_WITH_EMBEDDING_MODEL_ID
# LOCAL_EMBEDDING_BASE=http://local-llm.example:9293/v1
# LOCAL_EMBEDDING_PROVIDER=llamaswap
# Gateway image of all services except the database. See docs/image.md.
# Unset: litellm-gateway:local, which docker compose up -d --build builds.
# A deployment sets a registry name with a digest and runs docker compose up -d without --build.
# GATEWAY_IMAGE=ghcr.io/owner/litellm-gateway@sha256:REPLACE_WITH_INDEX_DIGEST
# Upstream LiteLLM image of a local build. Unset: the pin in Dockerfile.
# BASE_IMAGE=ghcr.io/berriai/litellm@sha256:REPLACE_WITH_INDEX_DIGEST
